<mxfile host="app.diagrams.net"><diagram id="aep-delivery-graph" name="AEP delivery graph (level 1)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="850" background="#0b1326" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 22px; color: #2fd9f4&quot;&gt;AEP delivery graph, level 1&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#dae2fd;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="explore" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 14px; color: #dae2fd&quot;&gt;explore&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;optional, writes nothing&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#171f33;strokeColor=#45464d;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="180" height="60" as="geometry"/></mxCell><mxCell id="propose" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 14px; color: #dae2fd&quot;&gt;propose *&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;agent: writes the change folder&lt;/div&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#222a3d;strokeColor=#2fd9f4;strokeWidth=3;fontColor=#dae2fd;fontFamily=Manrope;shadow=1;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="180" height="60" as="geometry"/></mxCell><mxCell id="validate" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 14px; color: #dae2fd&quot;&gt;validate&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;deterministic: --strict + scope&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#171f33;strokeColor=#45464d;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="180" height="60" as="geometry"/></mxCell><mxCell id="gate1" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 14px; color: #dae2fd&quot;&gt;human-gate-1&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;human: approves the proposal&lt;/div&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.15;whiteSpace=wrap;html=1;fillColor=#222a3d;strokeColor=#8dc63f;strokeWidth=3;fontColor=#dae2fd;fontFamily=Manrope;" vertex="1" parent="1"><mxGeometry x="790" y="110" width="180" height="60" as="geometry"/></mxCell><mxCell id="apply" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 14px; color: #dae2fd&quot;&gt;apply *&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;agent: implements tasks.md&lt;/div&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#222a3d;strokeColor=#2fd9f4;strokeWidth=3;fontColor=#dae2fd;fontFamily=Manrope;shadow=1;" vertex="1" parent="1"><mxGeometry x="790" y="290" width="180" height="60" as="geometry"/></mxCell><mxCell id="tv" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 14px; color: #dae2fd&quot;&gt;test-and-validate&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;deterministic: checks&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#171f33;strokeColor=#45464d;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;" vertex="1" parent="1"><mxGeometry x="540" y="290" width="180" height="60" as="geometry"/></mxCell><mxCell id="review" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 14px; color: #dae2fd&quot;&gt;review *&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;agent: fresh context, read-only&lt;/div&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#222a3d;strokeColor=#2fd9f4;strokeWidth=3;fontColor=#dae2fd;fontFamily=Manrope;shadow=1;" vertex="1" parent="1"><mxGeometry x="290" y="290" width="180" height="60" as="geometry"/></mxCell><mxCell id="pr" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 14px; color: #dae2fd&quot;&gt;pr-and-ci&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;deterministic: rebase + CI&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#171f33;strokeColor=#45464d;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="180" height="60" as="geometry"/></mxCell><mxCell id="esc" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 14px; color: #dae2fd&quot;&gt;ESCALATE&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;human: maintainer decides&lt;/div&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.15;whiteSpace=wrap;html=1;fillColor=#171f33;strokeColor=#7bd0ff;strokeWidth=3;dashed=1;fontColor=#dae2fd;fontFamily=Manrope;" vertex="1" parent="1"><mxGeometry x="415" y="420" width="180" height="60" as="geometry"/></mxCell><mxCell id="merge" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 14px; color: #dae2fd&quot;&gt;merge&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;deterministic: integrator&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#171f33;strokeColor=#45464d;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="180" height="60" as="geometry"/></mxCell><mxCell id="archive" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 14px; color: #dae2fd&quot;&gt;archive&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;deterministic: openspec archive&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#171f33;strokeColor=#45464d;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;" vertex="1" parent="1"><mxGeometry x="290" y="560" width="180" height="60" as="geometry"/></mxCell><mxCell id="queue" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 14px; color: #dae2fd&quot;&gt;release-queue&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;deterministic: git log&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#171f33;strokeColor=#45464d;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;" vertex="1" parent="1"><mxGeometry x="540" y="560" width="180" height="60" as="geometry"/></mxCell><mxCell id="gate2" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 14px; color: #dae2fd&quot;&gt;human-gate-2&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;human: OK names the version&lt;/div&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.15;whiteSpace=wrap;html=1;fillColor=#222a3d;strokeColor=#8dc63f;strokeWidth=3;fontColor=#dae2fd;fontFamily=Manrope;" vertex="1" parent="1"><mxGeometry x="790" y="560" width="180" height="60" as="geometry"/></mxCell><mxCell id="release" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 14px; color: #dae2fd&quot;&gt;release change&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;bump + tag v* + npm publish&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#171f33;strokeColor=#45464d;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;" vertex="1" parent="1"><mxGeometry x="790" y="690" width="180" height="60" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;" edge="1" parent="1" source="explore" target="propose"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;" edge="1" parent="1" source="propose" target="validate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;" edge="1" parent="1" source="validate" target="gate1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;" edge="1" parent="1" source="gate1" target="apply"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;" edge="1" parent="1" source="apply" target="tv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;" edge="1" parent="1" source="tv" target="review"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;" edge="1" parent="1" source="review" target="pr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="green" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;" edge="1" parent="1" source="pr" target="merge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;" edge="1" parent="1" source="merge" target="archive"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;" edge="1" parent="1" source="archive" target="queue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;" edge="1" parent="1" source="queue" target="gate2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="OK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;" edge="1" parent="1" source="gate2" target="release"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1" value="fail (max 3 cycles)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5bbfae;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;dashed=1;dashPattern=6 4;exitX=0.25;exitY=0;entryX=0.75;entryY=0;" edge="1" parent="1" source="validate" target="propose"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="85"/><mxPoint x="425" y="85"/></Array></mxGeometry></mxCell><mxCell id="c2" value="rewrite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5bbfae;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;entryX=0.25;entryY=0;" edge="1" parent="1" source="gate1" target="propose"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="55"/><mxPoint x="335" y="55"/></Array></mxGeometry></mxCell><mxCell id="c3" value="fail: cycle n of 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5bbfae;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;dashed=1;dashPattern=6 4;exitX=0.75;exitY=0;entryX=0.25;entryY=0;" edge="1" parent="1" source="tv" target="apply"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="675" y="262"/><mxPoint x="835" y="262"/></Array></mxGeometry></mxCell><mxCell id="c4" value="reservations: cycle n of 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5bbfae;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;entryX=0.75;entryY=0;" edge="1" parent="1" source="review" target="apply"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="225"/><mxPoint x="925" y="225"/></Array></mxGeometry></mxCell><mxCell id="c5" value="red CI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5bbfae;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="pr" target="apply"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="195"/><mxPoint x="1030" y="195"/><mxPoint x="1030" y="320"/></Array></mxGeometry></mxCell><mxCell id="x1" value="3 cycles exhausted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5bbfae;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="review" target="esc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x2" value="3 cycles exhausted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5bbfae;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="tv" target="esc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x3" value="maintainer instructs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5bbfae;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=11;labelBackgroundColor=#0b1326;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="esc" target="apply"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="450"/></Array></mxGeometry></mxCell><mxCell id="lg" value="&lt;div style=&quot;font-family: &#x27;Space Grotesk&#x27;, &#x27;Geist Sans&#x27;, sans-serif; font-weight: 700; font-size: 13px; color: #2fd9f4&quot;&gt;Legend&lt;/div&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;A working definition of this project, not an industry standard. The graph is a specification: no graph runtime. Twelve nodes, three loops, two human gates.&lt;/div&gt;&lt;br/&gt;&lt;div style=&quot;font-family: Manrope, &#x27;Geist Sans&#x27;, sans-serif; font-size: 11px; color: #dae2fd&quot;&gt;Rounded, cyan border and * : agent node (propose, apply, review).&lt;br/&gt;Square, grey border: deterministic code, a command or CI.&lt;br/&gt;Hexagon, green border: human gate (pause and resume from the pull request).&lt;br/&gt;Dashed teal arrow: cycle, bounded. One counter per change: apply loops share max 3 cycles, then ESCALATE to the maintainer.&lt;br/&gt;State lives in tasks.md, pull request labels (node:*, cycle:n, review:*, needs:maintainer) and .openspec.yaml.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#dae2fd;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="600" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
