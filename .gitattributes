# Golden files and fixtures are compared byte for byte, so they must be LF on every OS.
test/fixtures/** text eol=lf
test/golden/** text eol=lf
templates/** text eol=lf
# These fixtures hold lone CR, NEL, U+2028 and U+2029 on purpose: keep their bytes as they are.
test/fixtures/bad-agents/bad-cr-*.md -text
test/fixtures/bad-agents/bad-nel-*.md -text
test/fixtures/bad-agents/bad-ls-*.md -text
test/fixtures/bad-agents/bad-ps-*.md -text

# assessment-report: the skill's text files are LF on every OS, so tests that read them give the same result on Windows.
# (test/fixtures, test/golden and evals have their own .gitattributes; the tests also normalize CRLF when they read a file.)
plugins/assessment-report/skills/assessment-report/SKILL.md text eol=lf
plugins/assessment-report/skills/assessment-report/package.json text eol=lf
plugins/assessment-report/skills/assessment-report/references/** text eol=lf
plugins/assessment-report/skills/assessment-report/locales/** text eol=lf
plugins/assessment-report/skills/assessment-report/schema/** text eol=lf
plugins/assessment-report/skills/assessment-report/scripts/** text eol=lf
plugins/assessment-report/skills/assessment-report/templates/** text eol=lf
plugins/assessment-report/skills/assessment-report/test/*.mjs text eol=lf

# azure-terraform-stacks: the vendored yaml is a byte-for-byte copy of the npm package; no checkout may rewrite its line endings.
plugins/azure-terraform-stacks/skills/azure-terraform-stacks/scripts/vendor/** -text
# The corpus golden file is compared as data; keep it LF.
plugins/azure-terraform-stacks/skills/azure-terraform-stacks/test/yaml-corpus/golden.json text eol=lf

# azure-terraform-stacks: the templates are read by the generator and the golden trees are compared byte for byte, so they must be LF
# on every OS (the rules above are anchored at the repository root and do not reach the skill's own test/ and templates/ folders).
plugins/azure-terraform-stacks/skills/azure-terraform-stacks/test/fixtures/** text eol=lf
plugins/azure-terraform-stacks/skills/azure-terraform-stacks/test/golden/** text eol=lf
plugins/azure-terraform-stacks/skills/azure-terraform-stacks/templates/** text eol=lf
# The skill's own text and code: LF everywhere. Listed so that scripts/vendor/** (-text, above) is not matched.
plugins/azure-terraform-stacks/skills/azure-terraform-stacks/SKILL.md text eol=lf
plugins/azure-terraform-stacks/skills/azure-terraform-stacks/references/** text eol=lf
plugins/azure-terraform-stacks/skills/azure-terraform-stacks/scripts/*.mjs text eol=lf
plugins/azure-terraform-stacks/skills/azure-terraform-stacks/scripts/lib/** text eol=lf
