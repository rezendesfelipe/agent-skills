{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rezendesfelipe/agent-skills/plugins/docs-generator/skills/docs-generator/themes/docs-theme.schema.json",
  "title": "docs-generator theme",
  "description": "Look of the documents, Excel template and Office theme generated by the docs-generator skill. Fields left out are taken from the clean-modern theme.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "description": "Theme name, also used as the file name of the .xltx and .thmx outputs.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": { "$ref": "#/$defs/fontName" },
        "body": { "$ref": "#/$defs/fontName" },
        "mono": { "$ref": "#/$defs/fontName" },
        "files": {
          "description": "Font files for fonts that are not bundled with the skill. Paths are relative to the theme file.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "path"],
            "properties": {
              "family": { "$ref": "#/$defs/fontName" },
              "path": { "type": "string", "minLength": 1 },
              "weight": { "enum": ["normal", "bold"], "default": "normal" },
              "style": { "enum": ["normal", "italic"], "default": "normal" }
            }
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/color", "description": "Body text" },
        "textMuted": { "$ref": "#/$defs/color", "description": "Secondary text: footers, captions, cover details" },
        "accent": { "$ref": "#/$defs/color", "description": "Headings, links, cover band" },
        "onAccent": { "$ref": "#/$defs/color", "description": "Text drawn on the accent color" },
        "background": { "$ref": "#/$defs/color", "description": "Page background" },
        "tableHeader": { "$ref": "#/$defs/color", "description": "Background of table header rows and code blocks" },
        "border": { "$ref": "#/$defs/color", "description": "Table rules and separators" }
      }
    },
    "type": {
      "description": "Type sizes in points.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": { "type": "number", "minimum": 8, "maximum": 16 },
        "h1": { "type": "number", "minimum": 10, "maximum": 40 },
        "h2": { "type": "number", "minimum": 10, "maximum": 32 },
        "h3": { "type": "number", "minimum": 8, "maximum": 24 },
        "small": { "type": "number", "minimum": 6, "maximum": 12 },
        "title": { "type": "number", "minimum": 16, "maximum": 72, "description": "Cover title" },
        "lineHeight": { "type": "number", "minimum": 1, "maximum": 2, "description": "Multiple of the body size" },
        "paragraphSpacing": { "type": "number", "minimum": 0, "maximum": 24, "description": "Space after a paragraph, in points" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "enum": ["A4", "Letter"] },
        "margins": {
          "description": "Page margins in millimetres.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": { "type": "number", "minimum": 5, "maximum": 60 },
            "right": { "type": "number", "minimum": 5, "maximum": 60 },
            "bottom": { "type": "number", "minimum": 5, "maximum": 60 },
            "left": { "type": "number", "minimum": 5, "maximum": 60 }
          }
        }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": { "enum": ["accent-band", "plain"] },
        "logo": { "type": "string", "description": "PNG or JPEG file relative to the theme file" }
      }
    },
    "backCover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contact": { "type": "string" },
        "license": { "type": "string" }
      }
    },
    "office": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accents": {
          "description": "Office accent colors 2 to 6. Derived from the accent color when left out.",
          "type": "array",
          "items": { "$ref": "#/$defs/color" },
          "minItems": 5,
          "maxItems": 5
        }
      }
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "fontName": { "type": "string", "minLength": 1, "maxLength": 64 }
  }
}
